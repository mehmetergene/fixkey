  say "Keep this window open while you use Fixkey. Press Ctrl+C to stop the relay." "Hold dette vindue åbent, mens du bruger Fixkey. Tryk Ctrl+C for at stoppe relæet."
  exec python3 -I "$RELAY_DIR/relay.py"
