  else
    relay_choice=$(t "Run the relay in this window" "Kør relæet i dette vindue")
    auto_choice=$(t "Start the relay by itself when I log in" "Start relæet af sig selv, når jeg logger ind")
  fi
  if agent_installed "$REMINDER_AGENT"; then
    reminder_choice=$(t "Stop renewing by itself" "Stop med at forny af sig selv")
  else
    reminder_choice=$(t "Renew by itself over Wi-Fi every 7 days" "Forny af sig selv over Wi-Fi hver 7. dag")
  fi
  title "Fixkey" "Fixkey"
  printf '  1) %s\n' "$(t "Reinstall on the iPhone (every 7 days)" "Geninstaller på iPhonen (hver 7. dag)")"
  printf '  2) %s\n' "$relay_choice"
  printf '  3) %s\n' "$(t "Check everything" "Tjek alt")"
  printf '  4) %s\n' "$auto_choice"
  printf '  5) %s\n' "$reminder_choice"
  printf '  6) %s\n' "$(t "Choose the language model" "Vælg sprogmodellen")"
  printf '  7) %s\n' "$(t "Run the whole setup again" "Kør hele opsætningen igen")"
  printf '  q) %s\n' "$(t "Quit" "Afslut")"
  if ! interactive; then
    # Without a person at the keyboard, the menu chooses nothing.
    info "Run a command instead, for example ./fixkey doctor (see ./fixkey help)." "Kør en kommando i stedet, for eksempel ./fixkey doctor (se ./fixkey help)."
    return 0
  fi
  choice=$(ask "Choose" "Vælg" 3)
  case "$choice" in
    1) cmd_install ;;
    2) if agent_installed "$RELAY_AGENT"; then ACTION=add cmd_autostart; else cmd_relay; fi ;;
    3) cmd_doctor ;;
    4) if agent_installed "$RELAY_AGENT"; then autostart_off; else ACTION=on cmd_autostart; fi ;;
    5) if agent_installed "$REMINDER_AGENT"; then reminder_off; else reminder_on; fi ;;
    6) cmd_model ;;
    7) cmd_setup ;;
    *) return 0 ;;
  esac
}

case "$COMMAND" in
  "") cmd_menu ;;
  setup) cmd_setup ;;
  reinstall | install) cmd_install ;;
  relay) cmd_relay ;;
  doctor | check) cmd_doctor ;;
  model) cmd_model ;;
  configure) cmd_configure ;;
  test) cmd_test ;;
  autostart) cmd_autostart ;;
  reminder) cmd_reminder ;;
  renew) cmd_renew ;;
  uninstall) cmd_uninstall ;;
  help) cmd_help ;;
  *) echo "Unknown command: $COMMAND (see ./fixkey help)" >&2; exit 2 ;;
esac
