# Renewing by itself, for the reminder: build and install with no one at the keyboard. The exit code tells
# remind.sh what happened: 0 renewed, 3 the iPhone can't be reached now (try later), 4 Xcode needs the Apple ID
# again, 1 anything else.
cmd_renew() {
  local status
  ASSUME_YES=1
  DEVICE_ARG=${DEVICE_ARG:-$(cat "$SUPPORT_DIR/iphone" 2>/dev/null)}
  title "Renewing Fixkey on the iPhone over Wi-Fi, $(date '+%Y-%m-%d %H:%M')" "Fornyer Fixkey på iPhonen over Wi-Fi, $(date '+%Y-%m-%d %H:%M')"
  if ! check_config; then
    status=1
  elif ! find_iphone; then
    status=3
  elif ! build_app; then
    status=$(failure_status build/install.log)
  elif ! install_app; then
    status=$(failure_status build/install-device.log)
  else
    status=0
    record_expiry
    # A locked iPhone can't open apps; Fixkey is renewed anyway.
    launch_app >/dev/null 2>&1 || true
    show_expiry
  fi
  private_support_dir
  case "$status" in 0) echo ok ;; 3) echo later ;; 4) echo signin ;; *) echo failed ;; esac >"$SUPPORT_DIR/renew.result"
  return "$status"
}

# What a failed build or install means for renewing (see cmd_renew).
failure_status() {
  if grep -qiE "$SIGN_IN_ERRORS" "$1"; then
    echo 4
  elif grep -qiE "$UNREACHABLE_ERRORS|$LOCKED_ERRORS" "$1"; then
    echo 3
  else
    echo 1
  fi
}

